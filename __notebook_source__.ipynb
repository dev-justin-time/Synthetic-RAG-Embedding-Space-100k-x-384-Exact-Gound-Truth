import numpy as np
import os
import json
import time

class SyntheticEmbeddingSpace:
    """
    Generates synthetic high-dimensional vector spaces with known ground truth
    for benchmarking Approximate Nearest Neighbor (ANN) algorithms.
    """
    def __init__(self, dimensions=384, num_clusters=50):
        self.dimensions = dimensions
        self.num_clusters = num_clusters
        
        # Generate normalized cluster centroids (The "Topics")
        rng = np.random.default_rng(42)
        centroids = rng.standard_normal((num_clusters, dimensions))
        norms = np.linalg.norm(centroids, axis=1, keepdims=True)
        self.centroids = centroids / norms
        
    def generate_dataset(self, num_docs=100000, num_queries=1000, noise_level=0.3, k=10):
        rng = np.random.default_rng(123) 
        
        # 1. Assign documents to clusters (simulate varying cluster sizes using Dirichlet)
        cluster_weights = rng.dirichlet(np.ones(self.num_clusters) * 2) 
        doc_clusters = rng.choice(self.num_clusters, size=num_docs, p=cluster_weights)
        
        # 2. Generate Document Vectors (Centroid + Gaussian Noise)
        docs = np.empty((num_docs, self.dimensions), dtype=np.float32)
        for i in range(num_docs):
            centroid = self.centroids[doc_clusters[i]]
            noise = rng.standard_normal(self.dimensions) * noise_level
            vec = centroid + noise
            docs[i] = vec / np.linalg.norm(vec) # Normalize to unit sphere
            
        # 3. Generate Query Vectors & Calculate EXACT Ground Truth
        queries = np.empty((num_queries, self.dimensions), dtype=np.float32)
        ground_truth = np.empty((num_queries, k), dtype=np.int32)
        
        # Queries are slightly noisier than documents to simulate real user queries
        query_noise = noise_level * 1.5 
        
        print(f"Generating {num_queries} queries and calculating exact ground truth...")
        start = time.time()
        
        for q_idx in range(num_queries):
            target_cluster = rng.integers(0, self.num_clusters)
            centroid = self.centroids[target_cluster]
            noise = rng.standard_normal(self.dimensions) * query_noise
            query_vec = centroid + noise
            query_vec = query_vec / np.linalg.norm(query_vec)
            queries[q_idx] = query_vec
            
            # Calculate EXACT brute-force cosine similarity
            similarities = np.dot(docs, query_vec)
            
            # Get top K indices using argpartition (O(N) instead of O(N log N))
            if k < num_docs:
                top_k_partition = np.argpartition(similarities, -k)[-k:]
                top_k_sorted = top_k_partition[np.argsort(similarities[top_k_partition])[::-1]]
            else:
                top_k_sorted = np.argsort(similarities)[::-1][:k]
                
            ground_truth[q_idx] = top_k_sorted
            
        print(f"Ground truth generation complete in {time.time() - start:.2f} seconds.")
        return docs, queries, ground_truth

    def save_to_disk(self, output_dir, docs, queries, ground_truth):
        os.makedirs(output_dir, exist_ok=True)
        np.save(os.path.join(output_dir, 'database.npy'), docs)
        np.save(os.path.join(output_dir, 'queries.npy'), queries)
        np.save(os.path.join(output_dir, 'ground_truth.npy'), ground_truth)
        
        metadata = {
            "dimensions": self.dimensions,
            "num_clusters": self.num_clusters,
            "num_documents": docs.shape[0],
            "num_queries": queries.shape[0],
            "metric": "cosine",
            "noise_level": 0.3
        }
        with open(os.path.join(output_dir, 'metadata.json'), 'w') as f:
            json.dump(metadata, f, indent=4)
        print(f"Dataset successfully saved to {output_dir}/")

if __name__ == "__main__":
    # Generate a 100k x 384 dataset (Standard MiniLM dimension)
    generator = SyntheticEmbeddingSpace(dimensions=384, num_clusters=50)
    docs, queries, gt = generator.generate_dataset(
        num_docs=100_000, 
        num_queries=1_000, 
        noise_level=0.3, 
        k=10
    )
    generator.save_to_disk('./synthetic_rag_benchmark', docs, queries, gt)
